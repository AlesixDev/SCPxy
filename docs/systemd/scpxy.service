[Unit]
Description=SCPxy - proxy for SCP: Secret Laboratory
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=scpxy
Group=scpxy
ExecStart=/usr/local/bin/scpxy run --headless --config /etc/scpxy/config.toml
Restart=on-failure
RestartSec=5s
LimitNOFILE=65535

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
ReadOnlyPaths=/etc/scpxy

[Install]
WantedBy=multi-user.target
